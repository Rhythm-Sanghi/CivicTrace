# Environment Configuration for CivicTrace
# Development default uses SQLite for zero-friction local execution without requiring Docker/PostgreSQL.
# For production or PostGIS-enabled environments, set DATABASE_URL=postgresql://user:password@localhost:5432/civictrace

PROJECT_NAME=CivicTrace
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=civictrace-insecure-development-secret-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./civictrace_dev.db

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
EXPORT_DIR=./storage/exports
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate Limiting & Throttles
LOGIN_RATE_LIMIT=10
REPORT_RATE_LIMIT=30

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
